{
  "name": "reqspace",
  "version": "1.0.0",
  "description": "reqSpace Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "pack": "npm run build:client && npm run build:server && electron-builder --dir",
    "dist": "npm run build:client && npm run build:server && electron-builder"
  },
  "build": {
    "appId": "com.reqspaceclone.app",
    "productName": "reqSpace",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "server/dist",
        "to": "server/dist"
      },
      {
        "from": "server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "mysql2": "^3.24.4",
    "wait-on": "^9.1.0"
  }
}
