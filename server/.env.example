NODE_ENV=development
# Set to true to skip all rate limiters (login, register, share, mutations).
# The local PM2 process sets this in ecosystem.config.js. Leave unset in
# any deployment that is reachable from outside your machine.
# DISABLE_RATE_LIMIT=true
# Single source of truth for the listen port across server, Docker, k8s and
# the Electron shell (CR#17). The whole stack standardizes on 3005.
PORT=3005
MONGO_URI=mongodb://localhost:27017/reqspace-web
# Leave unset (or leave at this example value) in dev and the server will
# auto-generate and persist a random secret to server/.jwt-secret.local.
# For any real deployment set a real long random value here instead —
# otherwise every server instance/restart signs with a different secret.
JWT_SECRET=change_me_in_production_very_long_secret_key
JWT_TTL_DAYS=7
JWT_REFRESH_HOURS=24
CLIENT_DIST_PATH=../client/dist

# Session cookie's Secure flag. Defaults to true when NODE_ENV=production
# (required for a public HTTPS SaaS deployment) and false otherwise. Set
# explicitly to override — e.g. COOKIE_SECURE=false for a self-hosted,
# HTTP-only deployment on a trusted network (Tailscale, LAN).
# COOKIE_SECURE=true

# Admin Defaults — change ADMIN_PASSWORD before deploying anywhere reachable
# from outside your own machine. The server forces a password change on
# first login when this default is used, but the account is fully usable
# (including as superadmin) between "server started" and "first login".
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# OAuth2 sign-in (all optional; can also be set in Admin -> Settings)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_ENABLED=true
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_OAUTH_ENABLED=true
# Microsoft Azure / Entra ID. Tenant: a tenant id/domain, or common | organizations | consumers
MICROSOFT_CLIENT_ID=your_entra_application_client_id_here
MICROSOFT_CLIENT_SECRET=your_entra_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_ENABLED=true
# Custom OAuth2/OIDC provider (Keycloak, Okta, Authentik, ...)
CUSTOM_NAME=Company SSO
CUSTOM_CLIENT_ID=your_client_id_here
CUSTOM_CLIENT_SECRET=your_client_secret_here
CUSTOM_AUTHORIZE_URL=https://idp.example.com/authorize
CUSTOM_TOKEN_URL=https://idp.example.com/token
CUSTOM_USERINFO_URL=https://idp.example.com/userinfo
CUSTOM_SCOPE=openid email profile
CUSTOM_OAUTH_ENABLED=true
# Comma-separated; must list every <origin>/auth/<provider>/callback you register with the providers
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/google/callback,http://localhost:5173/auth/github/callback,http://localhost:5173/auth/microsoft/callback,http://localhost:5173/auth/custom/callback

# Offline / single-user mode: no sign-in, listens on 127.0.0.1 only. The desktop app sets this
# from its "Offline mode" option.
# REQSPACE_OFFLINE=true

# 32-byte key as 64 hex characters. Seals client-certificate private keys
# at rest (SEC-8). The value below is a public example for local tests only.
# Generate a unique key before storing real certificates: openssl rand -hex 32
CERT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
