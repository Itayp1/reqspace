NODE_ENV=production
PORT=3005
# Optional. Extra port in the default OAuth redirect allowlist (used only until an admin sets one in Settings).
# Optional. Built client, relative to server/. Default: ../client/dist (repo root client/dist).
# CLIENT_DIST_PATH=../client/dist
# Optional. Max JSON/form body size. Default: 5mb.
# MAX_BODY_SIZE=5mb

# Only bootstrap settings live here. Everything else (OAuth, SMTP, cookies,
# rate limits, trust proxy, ...) is stored in the database and edited in
# Admin -> Settings. The first visit to the app shows a screen to create the
# admin account; to reset it, delete the superadmin row from the database.


# Required. Long random value, identical on every replica. If it is missing, the login page
# has a Generate button; copy the value into the server's environment variables (this file works)
# and restart. Or: openssl rand -hex 32
JWT_SECRET=

# Required to save credentials in Settings. 32-byte key as 64 hex characters, identical on every
# replica. Seals client-certificate private keys and stored credentials at rest.
# The login page can generate one, or: openssl rand -hex 32
CERT_ENCRYPTION_KEY=

# Database: sqlite (default, mount a volume at the path), postgres or mysql.
DB_STORAGE_PATH=/data/reqspace.sqlite
# For postgres/mysql the connection string holds the host, credentials and database name.
# DB_CONNECTION_STRING=postgres://user:password@host:5432/reqspace

# Optional shared rate-limit store for multi-instance deployments.
# REDIS_URL=redis://localhost:6379
